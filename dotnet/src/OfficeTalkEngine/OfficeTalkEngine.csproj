<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>SpecWorks.OfficeTalkEngine</PackageId>
    <Version>0.3.0</Version>
    <Authors>SpecWorks</Authors>
    <Company>SpecWorks</Company>
    <Description>Execution engine for OfficeTalk documents — resolves addresses and applies deterministic operations to Microsoft Office documents via OpenXML SDK.</Description>
    <PackageTags>officetalk;word;excel;powerpoint;docx;openxml;execution;engine</PackageTags>
    <PackageProjectUrl>https://github.com/spec-works/OfficeTalkEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/spec-works/OfficeTalkEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OfficeTalkEngine.Tests" />
    <InternalsVisibleTo Include="OfficeTalkEngine.ParityTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageReference Include="SpecWorks.OfficeTalk" Version="0.1.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
