<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Configuration -->
    <PackageId>SpecWorks.OfficeTalk.CLI</PackageId>
    <Version>0.7.0</Version>
    <Authors>SpecWorks</Authors>
    <Company>SpecWorks</Company>
    <Description>Command-line tool for applying OfficeTalk operations to Microsoft Office documents. Supports Word (.docx) with snapshot semantics, validation, and address inspection.</Description>
    <PackageTags>officetalk;word;excel;powerpoint;docx;openxml;cli;tool;command-line</PackageTags>
    <PackageProjectUrl>https://github.com/spec-works/OfficeTalkEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/spec-works/OfficeTalkEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- .NET Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>officetalk</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeTalkEngine\OfficeTalkEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
